# Copy this file to .env for local development. Never commit the resulting .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DATABASE_URL=postgres://user:password@127.0.0.1:5432/pharmapocket
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
WAGTAILADMIN_BASE_URL=http://127.0.0.1:8000
DJANGO_SITE_ID=1

# Frontend origin allowed to send session cookies to the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Production defaults are secure automatically when DJANGO_DEBUG=0. Keep these
# explicit in the hosting provider when the frontend and API use different origins.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SESSION_COOKIE_SAMESITE=None
DJANGO_CSRF_COOKIE_SAMESITE=None
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=1

# Rate limiting (see "Rate limiting" in the README).
# Number of reverse proxies in front of the app. Defaults to 0 in debug and 1
# otherwise; it MUST match the real chain, or clients share a single bucket.
DJANGO_TRUSTED_PROXY_COUNT=0
# Rates use the DRF syntax "<count>/<period>" (s, min, hour, day). "off" disables one.
DJANGO_THROTTLE_RATE_ANON=60/min
DJANGO_THROTTLE_RATE_USER=300/min
DJANGO_THROTTLE_RATE_SENSITIVE_BURST=5/min
DJANGO_THROTTLE_RATE_SENSITIVE_SUSTAINED=30/hour
# Internal clients exempt from throttling (IPs or CIDRs, comma-separated).
# Set this to the SSR frontend's address: its requests carry every visitor.
DJANGO_THROTTLE_EXEMPT_IPS=
# Shared cache holding the rate-limit counters. Without it, each gunicorn worker
# counts on its own and the effective limit is multiplied by the worker count.
DJANGO_CACHE_URL=
